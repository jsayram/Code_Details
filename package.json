{
  "name": "codedetailsweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "validate-env": "node -r ts-node/register ./scripts/validateEnv.ts",
    "set-env": "node -r ts-node/register ./scripts/setEnv.ts",
    "dev": "cross-env NODE_ENV=development npm run set-env && npm run validate-env && next dev --turbopack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db:up": "tests/db/provision.sh",
    "test:db:down": "tests/db/teardown.sh",
    "test:convex:up": "tests/convex/up.sh",
    "test:convex:push": "node tests/convex/push.mjs",
    "test:convex:down": "tests/convex/down.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex/tsconfig.json",
    "lint:tests": "eslint tests playwright.config.ts vitest.config.mts next.config.ts eslint.config.mjs scripts/setEnv.ts",
    "build:isolated": "node tests/ci/isolated-build.mjs",
    "test:scripts": "node --test scripts/test-credential-logging.cjs && node -r ts-node/register scripts/test-repo-analyzer.ts",
    "build": "cross-env NODE_ENV=production npm run set-env && npm run validate-env && next build",
    "start": "cross-env NODE_ENV=production npm run set-env && npm run validate-env && next start",
    "db:generate": "cross-env NODE_ENV=development npm run set-env && npm run validate-env && drizzle-kit generate",
    "db:push": "cross-env NODE_ENV=development npm run set-env && npm run validate-env && drizzle-kit push",
    "db:studio": "cross-env NODE_ENV=development npm run set-env && npm run validate-env && drizzle-kit studio",
    "db:migrate": "cross-env NODE_ENV=development npm run set-env && npm run validate-env && node -r ts-node/register ./src/db/migrate.ts",
    "db:introspect": "cross-env NODE_ENV=development npm run set-env && npm run validate-env && drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@convex-dev/better-auth": "0.12.6",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.11",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/postcss": "^4.0.15",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.48.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.4",
    "framer-motion": "^12.4.7",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.476.0",
    "mermaid": "^11.12.1",
    "minimatch": "^10.1.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^6.9.1",
    "pocketflow": "^1.0.4",
    "postgres": "^3.4.5",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn-ui": "^0.9.5",
    "sonner": "^2.0.3",
    "stripe": "^17.7.0",
    "swr": "^2.3.7",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/postcss-load-config": "^3.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "jsdom": "30.1.3",
    "postcss": "^8.5.3",
    "postcss-load-config": "^6.0.1",
    "supabase": "^2.15.8",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.0.15",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
