# Copy to .env.local (git-ignored) and fill in. `npm run dev` loads
# .env.development, or .env.local when that file is missing (scripts/setEnv.ts).
# Values here are placeholders; never commit real ones.

# --- Next.js app: data and auth backend -------------------------------------
# Local Convex backend URL (http, loopback only). Unset = the data layer fails closed.
CODEDETAILS_CONVEX_URL=http://127.0.0.1:3240
# Its site (HTTP actions) URL; must also be a local http URL.
CODEDETAILS_CONVEX_SITE_URL=http://127.0.0.1:3241
# Shared secret between Next and Convex for internal calls. Use a long random string.
CODEDETAILS_INTERNAL_AUTH_SECRET=replace-with-random-string
# "convex" (default) or empty; selects the project read backend.
CODEDETAILS_PROJECT_READ_BACKEND=convex
# Auth backend: unset, empty or "better-auth" (anything else disables auth).
# CODEDETAILS_AUTH_BACKEND=better-auth
# Set to "off" to turn search off (the rollback switch).
# CODEDETAILS_SEARCH=off
# Comma-separated proxy IPs trusted for client-IP headers (optional).
# CODEDETAILS_AUTH_TRUSTED_PROXIES=

# --- Next.js app: features and integrations ---------------------------------
# Email of the admin dashboard moderator.
ADMIN_DASHBOARD_MODERATOR=you@example.com
# Public site origin, used for auth and OpenRouter referer headers.
SITE_URL=http://localhost:3000
# GitHub token for repo analysis and doc generation (optional, raises rate limits).
GITHUB_TOKEN=
# OpenAI key and default model for LLM features (optional).
OPENAI_API_KEY=
OPEN_AI_MODEL=gpt-4o-mini
# Azure OpenAI endpoint, only if you use the azure provider (optional).
# AZURE_OPENAI_ENDPOINT=

# --- Convex deployment env (set on the Convex backend, not read from this file)
# Set with `npx convex env set NAME value` against a backend you own, or via
# tests/convex/push.mjs for the test slots. Listed here so they are discoverable.
# SITE_URL=                                  # also read by Convex (auth base URL, email links)
# CONVEX_SITE_URL=                           # provided by Convex itself
# BETTER_AUTH_SECRET=                        # Better Auth signing secret
# JWKS=                                      # static JWKS for Convex auth
# GITHUB_CLIENT_ID=                          # GitHub OAuth app (optional)
# GITHUB_CLIENT_SECRET=
# CODEDETAILS_AUTH_TRUSTED_ORIGINS=          # comma-separated allowed origins
# CODEDETAILS_AUTH_EMAIL_PASSWORD=1          # "1" enables email+password sign-in
# CODEDETAILS_AUTH_REQUIRE_EMAIL_VERIFICATION=  # "0" skips verification (loopback only)
# CODEDETAILS_AUTH_TEST_CLIENT_IP=           # "1" test-only client IP header (loopback only)
# CODEDETAILS_EMAIL_HTTP_URL=                # transactional email HTTP endpoint
# CODEDETAILS_EMAIL_FROM=                    # sender address
# CODEDETAILS_LLM_USER_DAILY_CAP=            # per-user daily LLM call cap
# CODEDETAILS_LLM_GLOBAL_DAILY_CAP=          # global daily LLM call cap
# CODEDETAILS_SEARCH_ANALYTICS_ALLOWED=      # "1" enables search analytics collection
# CODEDETAILS_IMPORT_ALLOWED=                # "1" only on the one-time import backend
# CODEDETAILS_FIXTURES_ALLOWED=              # "1" only on test backends
# CODEDETAILS_ACCOUNT_PURGE_ALLOWED=         # "1" enables account purge jobs
# (Test-only gates such as the image sweep flag are set by tests/convex/push.mjs; not listed.)
