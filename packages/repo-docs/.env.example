# repo-docs CLI settings. Copy this file to .env in this folder (it is git-ignored)
# and fill in only what you use. Variables already set in your shell win over this file.
# The CLI never prints these values.

# GitHub token (optional): raises the API limit from 60 to 5,000 requests an hour and reads private repos. Sent only to api.github.com.
GITHUB_TOKEN=
# OpenAI key, for --provider openai (the default).
OPENAI_API_KEY=
# Anthropic key, for --provider anthropic.
ANTHROPIC_API_KEY=
# Google Gemini key, for --provider google.
GOOGLE_API_KEY=
# Groq key, for --provider groq.
GROQ_API_KEY=
# DeepSeek key, for --provider deepseek.
DEEPSEEK_API_KEY=
# OpenRouter key, for --provider openrouter.
OPENROUTER_API_KEY=
# xAI key, for --provider xai.
XAI_API_KEY=
# Azure OpenAI key, for --provider azure.
AZURE_OPENAI_API_KEY=
# Azure OpenAI endpoint, for example https://<resource>.openai.azure.com; it must also be on the allowlist below.
AZURE_OPENAI_ENDPOINT=
# Comma-separated model server origins that --base-url (or the Azure endpoint) may use, for example https://llm.example.com.
REPO_DOCS_LLM_BASE_URL_ALLOWLIST=
